BattleTowerHallway_Johto_MapScripts::
	map_script MAP_SCRIPT_ON_FRAME_TABLE, BattleTowerHallway_Johto_OnFrame
	.byte 0

BattleTowerHallway_Johto_OnFrame:
	map_script_2 VAR_JOHTO_SCENE_BATTLE_TOWER_HALLWAY, 0, BattleTowerHallway_Johto_BattleTowerHallwayChooseBattleRoomScript_Entry
	.2byte 0

BattleTowerHallway_Johto_BattleTowerHallwayChooseBattleRoomScript_Entry::
	lockall
	goto BattleTowerHallway_Johto_BattleTowerHallwayChooseBattleRoomScript


BattleTowerHallway_Johto_BattleTowerHallwayChooseBattleRoomScript:
	setvar VAR_JOHTO_SCENE_BATTLE_TOWER_HALLWAY, 1
	applymovement 1, BattleTowerHallway_Johto_Movement_ReceptionistGuidePlayer
	applymovement OBJ_EVENT_ID_PLAYER, BattleTowerHallway_Johto_Movement_PlayerFollowToRoom
	waitmovement OBJ_EVENT_ID_PLAYER
	warp MAP_JOHTO_BATTLE_TOWER_BATTLE_ROOM, 3, 7
	waitstate
	end

BattleTowerHallway_Johto_Movement_ReceptionistGuidePlayer:
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	face_up
	step_end

BattleTowerHallway_Johto_Movement_PlayerFollowToRoom:
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_up
	step_end

