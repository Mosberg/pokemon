	dynmultipush Johto_Menu_GoldenrodGameCorner_GoldenrodGameCornerTMVendorMenuHeader_Opt1, 1
	dynmultipush Johto_Menu_GoldenrodGameCorner_GoldenrodGameCornerTMVendorMenuHeader_Opt2, 2
