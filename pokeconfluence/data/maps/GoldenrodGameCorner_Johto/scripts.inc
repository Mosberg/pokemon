GoldenrodGameCorner_Johto_MoveTutorInsideScript:
	faceplayer
	message GoldenrodGameCorner_Johto_MoveTutorInsideText
	waitmessage
	waitbuttonpress
	closemessage
	applymovement 11, Johto_Movement_Face_Right
	waitmovement 11
	releaseall
	end

