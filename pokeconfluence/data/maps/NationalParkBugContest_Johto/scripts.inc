NationalParkBugContest_Johto_BugCatchingContestant1AText:
	.string "DON: I'm going to\n"
	.string "win! Don't bother\l"
	.string "me.$"

NationalParkBugContest_Johto_BugCatchingContestant2AText:
	.string "ED: My PARASECT\n"
	.string "puts POKéMON to\l"
	.string "sleep with SPORE.$"

NationalParkBugContest_Johto_BugCatchingContestant3AText:
	.string "NICK: I'm raising\n"
	.string "fast POKéMON for\l"
	.string "battles.$"

NationalParkBugContest_Johto_BugCatchingContestant4AText:
	.string "WILLIAM: I'm not\n"
	.string "concerned about\l"
	.string "winning."
	.string "\pI'm just looking\n"
	.string "for rare POKéMON.$"

NationalParkBugContest_Johto_BugCatchingContestant5AText:
	.string "BENNY: Ssh! You'll\n"
	.string "scare off SCYTHER."
	.string "\pI'll talk to you\n"
	.string "later.$"

NationalParkBugContest_Johto_BugCatchingContestant6AText:
	.string "BARRY: You should\n"
	.string "weaken bug POKéMON"
	.string "\pfirst, then throw\n"
	.string "a BALL.$"

NationalParkBugContest_Johto_BugCatchingContestant7AText:
	.string "CINDY: I love bug\n"
	.string "POKéMON."
	.string "\pI guess you must\n"
	.string "like them too.$"

NationalParkBugContest_Johto_BugCatchingContestant8AText:
	.string "JOSH: I've been\n"
	.string "collecting bug"
	.string "\pPOKéMON since I\n"
	.string "was just a baby."
	.string "\pThere's no way I'm\n"
	.string "going to lose!$"

NationalParkBugContest_Johto_BugCatchingContestant9AText:
	.string "SAMUEL: If you've\n"
	.string "got the time to"
	.string "\pchat, go find some\n"
	.string "bug POKéMON.$"

NationalParkBugContest_Johto_BugCatchingContestant10AText:
	.string "KIPP: I've studied\n"
	.string "about bug POKéMON\l"
	.string "a lot."
	.string "\pI'm going to win\n"
	.string "for sure.$"

NationalParkBugContest_Johto_NationalParkBugContestRelaxationSquareText:
	.string "RELAXATION SQUARE\n"
	.string "NATIONAL PARK$"

NationalParkBugContest_Johto_NationalParkBugContestBattleNoticeText:
	.string "What is this\n"
	.string "notice?"
	.string "\pPlease battle only\n"
	.string "in the grass."
	.string "\pNATIONAL PARK\n"
	.string "WARDEN'S OFFICE$"

NationalParkBugContest_Johto_NationalParkBugContestTrainerTipsText:
	.string "TRAINER TIPS"
	.string "\pPrint out MAIL by\n"
	.string "opening it then\l"
	.string "pressing START.$"
