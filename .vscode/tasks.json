{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}/pokeconfluence"
  },
  "tasks": [
    {
      "label": "Setup Environment",
      "type": "shell",
      "command": "scripts/setup.sh --extras",
      "problemMatcher": []
    },
    {
      "label": "Build Pokemon Confluence",
      "type": "shell",
      "command": "scripts/build.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "c",
        "fileLocation": ["relative", "${workspaceFolder}/pokeconfluence"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Build Release ROM",
      "type": "shell",
      "command": "scripts/build.sh release",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean Build Artifacts",
      "type": "shell",
      "command": "scripts/build.sh clean",
      "problemMatcher": []
    },
    {
      "label": "Run Confluence Tests",
      "type": "shell",
      "command": "scripts/test.sh",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run Full Test Suite",
      "type": "shell",
      "command": "scripts/test.sh --all",
      "group": "test",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Start Emulator Bridge (8888)",
      "type": "shell",
      "command": "scripts/play.sh 8888",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Audit Warps & Softlocks",
      "type": "shell",
      "command": "python3 ../tools/poke-migrator-pro/bin/poke-audit-warps ${workspaceFolder}/pokeconfluence",
      "problemMatcher": []
    }
  ]
}
