{
  "version": "2.0.0",
  "tasks": [
    // -------------------------------------------------------------
    // GBA ROM BUILD TASKS
    // -------------------------------------------------------------
    {
      "label": "Build ROM (Parallel)",
      "type": "shell",
      "command": "make -j$(nproc) MODERN=0",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "c",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Build ROM (Modern GCC / LTO)",
      "type": "shell",
      "command": "make -j$(nproc) MODERN=1",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean Build Artifacts",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": []
    },

    // -------------------------------------------------------------
    // HARDWARE & MEMORY ORACLE CHECKS
    // -------------------------------------------------------------
    {
      "label": "Audit RAM Boundaries (ram_check)",
      "type": "shell",
      "command": "${workspaceFolder}/tools/ram_check/ram_check ${workspaceFolder}/pokeemerald.elf",
      "dependsOn": "Build ROM (Parallel)",
      "problemMatcher": []
    },
    {
      "label": "Audit Warps & Softlocks",
      "type": "shell",
      "command": "python3 poke-migrator/scripts/poke_audit_warps.py ${workspaceFolder}",
      "problemMatcher": []
    },

    // -------------------------------------------------------------
    // TOOLCHAIN PIPELINES (PORYTILES & PORYSCRIPT)
    // -------------------------------------------------------------
    {
      "label": "Compile Secondary Tilesets (Porytiles)",
      "type": "shell",
      "command": "python3 poke-migrator/scripts/compile_tilesets_porytiles.py ../pokefirered ${workspaceFolder}",
      "problemMatcher": []
    },
    {
      "label": "Compile All Poryscripts",
      "type": "shell",
      "command": "python3 poke-migrator/scripts/poryscript_transpiler.py ${workspaceFolder}",
      "problemMatcher": []
    },

    // -------------------------------------------------------------
    // POKE-MIGRATOR MASTER AUTOMATION
    // -------------------------------------------------------------
    {
      "label": "Run Poke-Migrator Pipeline",
      "type": "shell",
      "command": "make -C poke-migrator migrate FRLG=../pokefirered EMERALD=${workspaceFolder}",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Create Rollback Snapshot",
      "type": "shell",
      "command": "python3 poke-migrator/scripts/backup_manager.py create ${workspaceFolder}",
      "problemMatcher": []
    }
  ]
}