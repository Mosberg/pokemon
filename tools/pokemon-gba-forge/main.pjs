$meta
  title = POKEMON GBA Forge — AI Gen 3 Sprite Generator
  shortTitle = GBA Forge
  description = Generate authentic Generation 3 (Ruby/Sapphire/Emerald, FireRed/LeafGreen) Pokémon sprites from text. Hardware-accurate 4bpp 16-color palettes, BGR555 snapping, 8x8 tile grid, shared front/back palettes, index-matched shiny swap, battle/icon/overworld/item/footprint/terrain/backdrop export.
  tags = pokemon, gba, pixel-art, sprite-generator, pokemon, emerald, firered, gamedev
  header
    mode = minimal

generateImage = {import:text-to-image-plugin}
generateText = {import:ai-text-plugin}

// Pokémon type list — used for prompt building + randomize
pokeType
  Normal
  Fire
  Water
  Electric
  Grass
  Ice
  Fighting
  Poison
  Ground
  Flying
  Psychic
  Bug
  Rock
  Ghost
  Dragon
  Dark
  Steel
  Fairy

