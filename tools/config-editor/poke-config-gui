#!/usr/bin/env bash
# poke-config-gui - Interactive GUI Config Editor for Pokémon Confluence
# Supports modern Web GUI (default, opens browser) and Native Desktop GUI (--desktop)

set -e

# Resolve symlink to real directory
REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"
PYTHON_EXEC="/home/mosberg/wsl_projects/pokemon/pokeconfluence/.venv/bin/python"

if [ ! -f "$PYTHON_EXEC" ]; then
    PYTHON_EXEC="python3"
fi

if [[ "$1" == "--desktop" || "$1" == "-d" ]]; then
    exec "$PYTHON_EXEC" "$SCRIPT_DIR/desktop_gui.py" "${@:2}"
else
    exec "$PYTHON_EXEC" "$SCRIPT_DIR/web_server.py" "$@"
fi
